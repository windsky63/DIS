# 图纸标识识别系统 Docker Compose 配置
DRAWING_MARK_RECOGNITION_VERSION=2.0.10
DRAWING_MARK_RECOGNITION_BUILD_ID=20260915-170738
DRAWING_MARK_RECOGNITION_ALGORITHM_VERSION=2026-09-08.1
DRAWING_MARK_RECOGNITION_PORT=8768
# HTTPS 反向代理部署时设为 true；直接通过 HTTP 内网访问时保持 false
DRAWING_MARK_RECOGNITION_SESSION_SECURE=false

# 任务与审计配置
DRAWING_MARK_RECOGNITION_MAX_BODY_MB=350
DRAWING_MARK_RECOGNITION_MAX_UPLOAD_FILE_MB=350
DRAWING_MARK_RECOGNITION_MAX_CONCURRENT_UPLOADS=2
DRAWING_MARK_RECOGNITION_MIN_FREE_DISK_MB=512
DRAWING_MARK_RECOGNITION_UPLOAD_RETENTION_HOURS=24
DRAWING_MARK_RECOGNITION_MAX_CONCURRENT_ANALYSES=1
DRAWING_MARK_RECOGNITION_MAX_PENDING_ANALYSES=4
DRAWING_MARK_RECOGNITION_JOB_RETENTION_DAYS=90
DRAWING_MARK_RECOGNITION_AUDIT_MAX_MB=10
DRAWING_MARK_RECOGNITION_AUDIT_BACKUPS=5

# DeepSeek AI 助手；密钥只保存在服务端的 .env 中
DRAWING_MARK_RECOGNITION_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# 其他 OpenAI 兼容服务可通过以下变量覆盖 DeepSeek 默认配置
DRAWING_MARK_RECOGNITION_AI_API_URL=
DRAWING_MARK_RECOGNITION_AI_API_KEY=
DRAWING_MARK_RECOGNITION_AI_MODEL=

# 网络受限环境可替换镜像源
DRAWING_MARK_RECOGNITION_NODE_IMAGE=node:24-bookworm-slim
DRAWING_MARK_RECOGNITION_PYTHON_IMAGE=python:3.14-slim-bookworm
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
