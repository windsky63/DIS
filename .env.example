# 图纸标识识别系统 Docker Compose 配置
DRAWING_MARK_RECOGNITION_VERSION=2.0.4
DRAWING_MARK_RECOGNITION_BUILD_ID=manual
DRAWING_MARK_RECOGNITION_PORT=8768

# 任务与审计配置
DRAWING_MARK_RECOGNITION_MAX_BODY_MB=350
DRAWING_MARK_RECOGNITION_MAX_CONCURRENT_ANALYSES=2
DRAWING_MARK_RECOGNITION_MAX_PENDING_ANALYSES=4
DRAWING_MARK_RECOGNITION_JOB_RETENTION_DAYS=90
DRAWING_MARK_RECOGNITION_AUDIT_MAX_MB=10
DRAWING_MARK_RECOGNITION_AUDIT_BACKUPS=5

# 网络受限环境可替换镜像源
DRAWING_MARK_RECOGNITION_NODE_IMAGE=node:24-bookworm-slim
DRAWING_MARK_RECOGNITION_PYTHON_IMAGE=python:3.14-slim-bookworm
NPM_REGISTRY=https://registry.npmjs.org
PIP_INDEX_URL=https://pypi.org/simple
